#version 450

in vec3 light_dir;
in vec3 normal;
in vec2 uv_position;
in float viewDistance;
flat in int mat_id;

uniform bool smoothed;
uniform bool toonShaded;
uniform sampler2D textures[10];

layout(location=0) out vec4 output_color;

void main() {
    float d = max(0.0, dot(light_dir, normal));

    // Compute D --> Details based on distance
    float D;
    if (smoothed) {
        D = 1.0 - clamp(viewDistance / 120.0, 0.0, 1.0);
    }
    else {
        D = 1.0 - log(viewDistance) / log(200);
    }
    D = pow(D, 0.5);
    D = clamp(D, 0.0, 1.0);

	vec4 color = texture(textures[mat_id], uv_position);

    float diffuse = max(0.0, dot(normal, light_dir));
    float levels = mix(2.0, 4.0, D);
    float toonLight = min(1.0, floor(diffuse * levels) / (levels - 1.0));

    if (toonShaded)
    {
        output_color = vec4(color.rgb * toonLight, color.a);
    }
    else
    {
        output_color = color;
    }
}
