#version 450

in vec3 light_dir;
in vec3 normal;
in vec2 uv_position;

uniform sampler2D kirby_sampler;

layout(location=0) out vec4 output_color;

float intensity;
float factor;

void main() {
 
    intensity = dot(normalize(normal), normalize(light_dir));

    if (intensity > 0.95)
        factor = 1.0;
	else if (intensity > 0.5)
		factor = 0.7;
	else if (intensity > 0.25)
		factor = 0.35;
	else
		factor = 0.1;
    
    output_color = vec4(texture(kirby_sampler, uv_position)) * factor;
}
