#version 450

in vec3 out_color;
in vec3 light_dir;
in vec3 normal;
in vec3 light_col;

layout(location=0) out vec4 output_color;

void main() {
    //output_color = vec4(out_color, 1.0);
    float d = dot(light_dir, normal);
    output_color = vec4(d * out_color * light_col.rgb, 1.0);
    // output_color = vec4(1.0, 0.0, 0.0, 1.0);
}
